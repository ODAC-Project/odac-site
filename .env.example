APP_NAME=ODAC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://odac.tune.audio

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The site's only state: ingested snapshots + the projection of the current one.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/odac/database/database.sqlite

# Public read-only site: no session, no cookie.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# latest.json published by the ODAC CI (the artifact is resolved next to it).
ODAC_SOURCE=https://raw.githubusercontent.com/ODAC-Project/ODAC/main/dist/latest.json

# How the fingerprint is derived from the artifact bytes, as tools/build.py
# does: sha256-16 = first 16 hex chars of the SHA-256.
ODAC_FINGERPRINT=sha256-16
ODAC_MAX_ARTIFACT_BYTES=67108864
ODAC_HTTP_TIMEOUT=30

# NAMED reverse proxies allowed to set X-Forwarded-* (IPs or CIDR, comma
# separated). Empty = nginx is the first hop. A wildcard is refused at boot.
ODAC_TRUSTED_PROXIES=

# Where "Contribuer" leads (v1: mozaiklabs.fr). Empty = no button.
ODAC_CONTRIBUTE_URL=

# Contribution: sign-in with a Mozaik Labs account and forwarding to GitHub.
ODAC_MOZAIK_CONNECT_URL=https://mozaiklabs.fr/odac/connect
ODAC_MOZAIK_SECRET=
ODAC_GITHUB_TOKEN=
