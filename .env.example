APP_NAME=ODAC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://odac.tune.audio

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The site's only state: ingested snapshots + the projection of the current one.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/odac/database/database.sqlite

# Public read-only site: no session, no cookie.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Where the ODAC CI publishes latest.json and the fingerprinted artifact:
# the dist/ folder of the public repository (http(s) base URL) or a local dir.
ODAC_SOURCE=

# How the fingerprint is derived from the artifact bytes (to confirm against
# tools/build.py): sha256-16 = first 16 hex chars of the SHA-256.
ODAC_FINGERPRINT=sha256-16
ODAC_MAX_ARTIFACT_BYTES=67108864
ODAC_HTTP_TIMEOUT=30

# NAMED reverse proxies allowed to set X-Forwarded-* (IPs or CIDR, comma
# separated). Empty = nginx is the first hop. A wildcard is refused at boot.
ODAC_TRUSTED_PROXIES=

# Where "Contribuer" leads (v1: mozaiklabs.fr). Empty = no button.
ODAC_CONTRIBUTE_URL=
